# Скопируй в .env (или используй systemd Environment=) и заполни.
# Реальные значения никогда не коммить.

# OpenAI Organization Admin key (sk-admin-...)
OPENAI_API_KEY=

# Anthropic Admin API key (для /v1/organizations/* endpoints).
# Если admin-ключа пока нет — оставь пустым и поставь HMND_ANTHROPIC_MOCK=true ниже,
# тогда дашборд покажет синтетические Anthropic-данные на тех же юзерах.
ANTHROPIC_API_KEY=

# GitHub PAT (fine-grained, scopes: repo:read, pull_requests:read, metadata:read)
GITHUB_TOKEN=

# Feature flags
HMND_GITHUB_ENABLED=false   # выключаем страницы Repos/PR Quality и AI code share KPI до подключения GitHub
HMND_DEMO_DATA=false        # для production выключи, чтобы не подмешивать seed-данные
HMND_ANTHROPIC_MOCK=false   # true — синтезировать Anthropic-расходы, пока нет admin-ключа

# Куда положить SQLite (опционально)
# HMND_DB_PATH=/var/lib/hmnd/hmnd.db
